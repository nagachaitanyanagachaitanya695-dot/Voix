# is commented out by default.
#.vscode/

# Flutter/Dart/Pub related
**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins-dependencies
.pub-cache/
.pub/
/build/
/coverage/

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release

# Firebase config (added via `flutterfire configure`) — never commit
android/app/google-services.json
ios/Runner/GoogleService-Info.plist
lib/firebase_options.dart

# Screenshots are regenerated on demand:
#   flutter test test/render_screens.dart --update-goldens --tags render
# They are committed so the UI can be reviewed without a device.

# Backend URL and app token, injected with --dart-define-from-file.
# Never commit the real one.
env.json
