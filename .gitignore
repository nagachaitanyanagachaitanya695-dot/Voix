# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release

# Firebase config generated by `flutterfire configure`.
#
# lib/firebase_options.dart is deliberately NOT ignored: the app imports it, so
# a clone without it does not compile. It ships with placeholders and no
# secrets. Once you run `flutterfire configure` the real project values land
# there and get committed too — that is fine, because a Firebase apiKey
# identifies a project rather than authorising anything. What protects the data
# is the Firestore security rules in docs/FIREBASE_SETUP.md.
android/app/google-services.json
ios/Runner/GoogleService-Info.plist

# Screenshots are regenerated on demand:
#   flutter test test/render_screens.dart --update-goldens --tags render
# They are committed so the UI can be reviewed without a device.

# Backend URL and app token, injected with --dart-define-from-file.
# Never commit the real one.
env.json

# Flutter web build output. The web target exists only so the app can be run
# and screenshotted without an Android device; it is not shipped.
/build/
