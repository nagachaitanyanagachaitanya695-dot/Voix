<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- VoixPalette.darkBg — keeps the OS launch window the same colour as the
         splash screen, so there is no white flash before the orb ignites. -->
    <color name="voix_launch_bg">#04060F</color>

    <!-- The adaptive launcher icon's background layer. Must stay in step with
         the `plate` colour in test/generate_launcher_icons.dart, which knocks
         the microphone out of the foreground in exactly this value. -->
    <color name="ic_launcher_background">#080C1C</color>
</resources>
