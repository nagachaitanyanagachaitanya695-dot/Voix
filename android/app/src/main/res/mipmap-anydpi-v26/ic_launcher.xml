<?xml version="1.0" encoding="utf-8"?>
<!-- Adaptive icon, used from Android 8 onward. The launcher masks these layers
     into whatever shape the device theme uses (circle, squircle, teardrop),
     which is why the mark is drawn well inside the 108dp canvas.

     The monochrome layer supplies Android 13+ themed icons: the system throws
     away its colour and tints the alpha with the user's wallpaper palette. -->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@color/ic_launcher_background" />
    <foreground android:drawable="@mipmap/ic_launcher_foreground" />
    <monochrome android:drawable="@mipmap/ic_launcher_monochrome" />
</adaptive-icon>
